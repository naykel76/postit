{
    "name": "naykel/postit",
    "description": "Post management package for NayKel Laravel Applications",
    "license": "MIT",
    "authors": [
        {
            "name": "Nathan Watts",
            "email": "nathan@naykel.com.au",
            "homepage": "https://naykel.com.au"
        }
    ],
    "homepage": "https://github.com/naykel76/postit.git",
    "keywords": [
        "Laravel",
        "Postit"
    ],
    "require": {
        "php": "^8.2",
        "naykel/gotime": "^2.0",
        "spatie/laravel-sluggable": "^3.7"
    },
    "require-dev": {
        "laravel/pint": "^1.25",
        "pestphp/pest": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "scripts": {
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "autoload": {
        "psr-4": {
            "Naykel\\Postit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Naykel\\Postit\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Naykel\\Postit\\PostitServiceProvider"
            ],
            "aliases": {
                "Postit": "Naykel\\Postit\\Facades\\Postit"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}